+#ifdef FPV_HOOKS
+bool
+CVehicle::DoDronePropCollision(float radius)
+{
+	CVector pos(0.0f, 0.0f, 0.0f);
+	CVector max(radius, radius, 0.15f);
+	CVector min(-radius, -radius, -0.15f);
+	rotorColModel.boundingBox.Set(min, max);
+	rotorColModel.boundingSphere.Set(radius, pos);
+	rotorColSphere.Set(radius, pos, 0, 0);
+	rotorColModel.spheres = &rotorColSphere;
+	rotorColModel.numSpheres = 1;
+
+	CMatrix &matrix = GetMatrix();
+	CVector at = GetPosition();
+	bool hadCollision = false;
+	int minX = Max(CWorld::GetSectorIndexX(at.x - radius), 0);
+	int minY = Max(CWorld::GetSectorIndexY(at.y - radius), 0);
+	int maxX = Min(CWorld::GetSectorIndexX(at.x + radius), NUMSECTORS_X - 1);
+	int maxY = Min(CWorld::GetSectorIndexY(at.y + radius), NUMSECTORS_Y - 1);
+	CWorld::AdvanceCurrentScanCode();
+	for(int y = minY; y <= maxY; y++)
+		for(int x = minX; x <= maxX; x++){
+			CSector *sector = CWorld::GetSector(x, y);
+			if(BladeColSectorList(sector->m_lists[ENTITYLIST_PEDS], rotorColModel, matrix, ROTOR_TOP, 0.0f))
+				hadCollision = true;
+			if(BladeColSectorList(sector->m_lists[ENTITYLIST_PEDS_OVERLAP], rotorColModel, matrix, ROTOR_TOP, 0.0f))
+				hadCollision = true;
+		}
+	rotorColModel.spheres = nil;
+	rotorColModel.numSpheres = 0;
+	return hadCollision;
+}
+#endif
+
 bool
 CVehicle::BladeColSectorList(CPtrList &list, CColModel &rotorColModel, CMatrix &matrix, int16 rotorType, float damageMult)
 {
