diff --git a/src/core/CdStreamWeb.cpp b/src/core/CdStreamWeb.cpp
new file mode 100644
index 0000000..210ebd5
--- /dev/null
+++ b/src/core/CdStreamWeb.cpp
@@ -0,0 +1,167 @@
+// Web (Emscripten) CdStream: the IMG files are in the browser's memory
+// (MEMFS), so a read completes at once, on the game's only thread. The
+// interface and status codes are those of CdStreamPosix.cpp.
+#ifdef __EMSCRIPTEN__
+#include "common.h"
+#include "crossplatform.h"
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "CdStream.h"
+#include "rwcore.h"
+#include "MemoryMgr.h"
+
+struct CdReadInfo
+{
+	int32 nStatus;
+};
+
+static char gCdImageNames[MAX_CDIMAGES + 1][64];
+static int32 gNumImages;
+static int32 gNumChannels;
+static int32 gImgFiles[MAX_CDIMAGES]; // -1: error 0: unused, otherwise fd + 1
+static char *gImgNames[MAX_CDIMAGES];
+static CdReadInfo *gpReadInfo;
+static int32 lastPosnRead;
+
+void
+CdStreamInitThread(void)
+{
+}
+
+void
+CdStreamInit(int32 numChannels)
+{
+	gNumImages = 0;
+	gNumChannels = numChannels;
+	gpReadInfo = (CdReadInfo *)calloc(numChannels, sizeof(CdReadInfo));
+}
+
+uint32
+GetGTA3ImgSize(void)
+{
+	struct stat st;
+	if (gImgFiles[0] <= 0 || fstat(gImgFiles[0] - 1, &st) != 0)
+		return 0;
+	return (uint32)st.st_size;
+}
+
+void
+CdStreamShutdown(void)
+{
+	free(gpReadInfo);
+	gpReadInfo = nil;
+}
+
+int32
+CdStreamRead(int32 channel, void *buffer, uint32 offset, uint32 size)
+{
+	lastPosnRead = size + offset;
+	int32 hImage = gImgFiles[_GET_INDEX(offset)];
+	CdReadInfo *pChannel = &gpReadInfo[channel];
+	if (hImage <= 0) {
+		pChannel->nStatus = STREAM_ERROR;
+		return STREAM_SUCCESS;
+	}
+	size_t bytes = (size_t)size * CDSTREAM_SECTOR_SIZE;
+	ssize_t got = pread(hImage - 1, buffer, bytes, (off_t)_GET_OFFSET(offset) * CDSTREAM_SECTOR_SIZE);
+	pChannel->nStatus = got < 0 ? STREAM_ERROR : STREAM_NONE;
+	return STREAM_SUCCESS;
+}
+
+int32
+CdStreamGetStatus(int32 channel)
+{
+	CdReadInfo *pChannel = &gpReadInfo[channel];
+	int32 status = pChannel->nStatus;
+	pChannel->nStatus = STREAM_NONE;
+	return status;
+}
+
+int32
+CdStreamGetLastPosn(void)
+{
+	return lastPosnRead;
+}
+
+int32
+CdStreamSync(int32 channel)
+{
+	return gpReadInfo[channel].nStatus;
+}
+
+void
+AddToQueue(Queue *queue, int32 item)
+{
+	queue->items[queue->tail] = item;
+	queue->tail = (queue->tail + 1) % queue->size;
+}
+
+int32
+GetFirstInQueue(Queue *queue)
+{
+	if (queue->head == queue->tail)
+		return -1;
+	return queue->items[queue->head];
+}
+
+void
+RemoveFirstInQueue(Queue *queue)
+{
+	if (queue->head == queue->tail)
+		return;
+	queue->head = (queue->head + 1) % queue->size;
+}
+
+bool
+CdStreamAddImage(char const *path)
+{
+	int fd = open(path, O_RDONLY);
+	if (fd == -1) {
+		char *real = casepath(path, false);
+		if (real) {
+			fd = open(real, O_RDONLY);
+			free(real);
+		}
+	}
+	if (fd == -1) {
+		debug("cdvd_stream: can't open %s\n", path);
+		return false;
+	}
+	gImgFiles[gNumImages] = fd + 1;
+	gImgNames[gNumImages] = strdup(path);
+	strncpy(gCdImageNames[gNumImages], path, 63);
+	gNumImages++;
+	return true;
+}
+
+char *
+CdStreamGetImageName(int32 cd)
+{
+	if (gImgFiles[cd] > 0)
+		return gImgNames[cd];
+	return nil;
+}
+
+void
+CdStreamRemoveImages(void)
+{
+	for (int32 i = 0; i < gNumChannels; i++)
+		gpReadInfo[i].nStatus = STREAM_NONE;
+	for (int32 i = 0; i < gNumImages; i++) {
+		if (gImgFiles[i] > 0)
+			close(gImgFiles[i] - 1);
+		free(gImgNames[i]);
+		gImgFiles[i] = 0;
+		gImgNames[i] = nil;
+	}
+	gNumImages = 0;
+}
+
+int32
+CdStreamGetNumImages(void)
+{
+	return gNumImages;
+}
+#endif
