diff --git a/src/extras/fpvhooks.h b/src/extras/fpvhooks.h
new file mode 100644
index 0000000..63aba67
--- /dev/null
+++ b/src/extras/fpvhooks.h
@@ -0,0 +1,62 @@
+#pragma once
+
+// Hook points for the FPV drone mod (reVC-mac-fpv) in the web build, where
+// the mod is compiled into the game instead of patching its code at run time.
+//
+// A function with FPV_HOOK at its top calls the mod's replacement while one
+// is set; the replacement runs the original by calling the function again,
+// which the busy flag lets through. The mod fills gFpvHooks by name
+// (web/src/hook_web.cpp). Without FPV_HOOKS (any other build) it all
+// compiles to nothing.
+
+#ifdef FPV_HOOKS
+
+#define FPV_HOOK_LIST(X) \
+	X(CGame_Process) X(CCamera_Process) X(RenderScene) X(CHud_Draw) X(CHud_DrawAfterFade) \
+	X(CMessages_Display) X(CDarkel_DrawMessages) X(CGarages_PrintMessages) X(CPickups_RenderPickUpText) \
+	X(DisplayRadioStationName) X(CColStore_LoadCollision) X(FindPlayerCentreOfWorld) \
+	X(FindPlayerCentreOfWorld_NoSniperShift) X(FindPlayerCoors) X(CClouds_RenderBackground) \
+	X(CClouds_RenderHorizon) X(CRenderer_ScanWorld) X(CRenderer_ScanSectorPoly) X(RenderEffects) \
+	X(CPlayerPed_ProcessControl) X(PedInflictDamage)
+
+enum FpvHookId {
+#define FPV_HOOK_ENUM(name) FPVH_##name,
+	FPV_HOOK_LIST(FPV_HOOK_ENUM)
+#undef FPV_HOOK_ENUM
+	FPVH_COUNT
+};
+
+extern void *gFpvHooks[FPVH_COUNT];
+extern bool gFpvHookBusy[FPVH_COUNT];
+extern const char *const gFpvHookNames[FPVH_COUNT];
+
+struct FpvHookGuard {
+	int id;
+	FpvHookGuard(int i) : id(i) { gFpvHookBusy[i] = true; }
+	~FpvHookGuard() { gFpvHookBusy[id] = false; }
+};
+
+// type: the replacement's function pointer type; the rest: its arguments.
+#define FPV_HOOK(name, type, ...) \
+	if (gFpvHooks[FPVH_##name] && !gFpvHookBusy[FPVH_##name]) { \
+		FpvHookGuard fpvGuard_(FPVH_##name); \
+		return ((type)gFpvHooks[FPVH_##name])(__VA_ARGS__); \
+	}
+
+// --- the Demolition Man demo (web/src/mission.cpp) ---------------------------
+class CVehicle;
+// LOAD_AND_LAUNCH_MISSION: the mission to start instead (or the same).
+extern int (*gFpvMissionLaunch)(int mission);
+// IS_IN_CAR_FIRE_BUTTON_PRESSED: true also when this says so (the drone's
+// "drop the bomb" key or switch).
+extern bool (*gFpvCarFire)(void);
+// CAutomobile::VehicleDamage: true skips the collision damage (the RC
+// helicopter flown by the drone takes the drone's crashes instead).
+extern bool (*gFpvSkipVehicleDamage)(CVehicle *vehicle);
+// PRINT_HELP: true skips the help text with this key (help about controls
+// the drone doesn't have).
+extern bool (*gFpvSkipHelp)(const char *key);
+
+#else
+#define FPV_HOOK(name, type, ...)
+#endif
